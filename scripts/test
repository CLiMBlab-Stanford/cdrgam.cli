#!/bin/sh
set -eu

scope=${1:-all}
case "$scope" in
    architecture) tests='tests/architecture.R' ;;
    cli) tests='tests/cli.R' ;;
    paths) tests='tests/paths.R' ;;
    registry) tests='tests/registry.R' ;;
    fingerprints) tests='tests/fingerprints.R' ;;
    identities) tests='tests/definition-identities.R' ;;
    viz) tests='tests/viz.R' ;;
    effects) tests='tests/effect-queries.R' ;;
    tests) tests='tests/test-definitions.R' ;;
    integration) tests='tests/phase1.R' ;;
    render) tests='tests/render.R' ;;
    methods) tests='tests/methods.R' ;;
    portability) tests='tests/paths.R tests/phase1.R'; policy_test=true ;;
    all) tests='tests/architecture.R tests/cli.R tests/paths.R tests/registry.R tests/fingerprints.R tests/definition-identities.R tests/effect-queries.R tests/test-definitions.R tests/render.R tests/methods.R tests/viz.R tests/phase1.R' ;;
    *)
        echo "Unknown test scope: $scope" >&2
        echo 'Expected architecture, cli, paths, registry, fingerprints, identities, effects, tests, render, methods, viz, integration, portability, or all' >&2
        exit 2
        ;;
esac

r_bin=$(./scripts/r-bin)

temporary_root=${TMPDIR:-/tmp}
if [ ! -d "$temporary_root" ] || [ ! -w "$temporary_root" ]; then
    temporary_root=/tmp
fi
test_library=$(mktemp -d "$temporary_root/cdrgam-cli-test-lib.XXXXXX")
trap 'rm -rf "$test_library"' EXIT HUP INT TERM
mkdir -p "$test_library/cache"
export XDG_CACHE_HOME="$test_library/cache"
"$r_bin" CMD INSTALL --no-byte-compile -l "$test_library" . >/dev/null

for test_file in $tests; do
    echo "RUN $test_file"
    R_LIBS="$test_library${R_LIBS:+:$R_LIBS}" \
        "$r_bin" --vanilla --slave -f "$test_file"
done

if [ "${policy_test:-false}" = true ]; then
    ./scripts/test-preflight-policy
fi
